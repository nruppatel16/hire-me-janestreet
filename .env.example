# Copy to .env and fill in. Never commit .env.
# Local Postgres cluster started by scripts/db.sh (port 5433, no password, local socket/TCP only).
DATABASE_URL=postgresql://xmatch@localhost:5433/xmatch
# Separate DB used by integration tests (created by scripts/db.sh init).
TEST_DATABASE_URL=postgresql://xmatch@localhost:5433/xmatch_test

# Provider keys for embeddings / LLM (Milestone 2+). Not needed for ingest.
OPENAI_API_KEY=
XMATCH_GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# This system is read-only. It never needs Kalshi or Polymarket trading credentials. Do not add any.
